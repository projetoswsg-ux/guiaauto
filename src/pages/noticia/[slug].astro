---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const { Content } = await noticia.render();

const formatDate = (date: Date) =>
  date.toLocaleDateString('pt-BR', {
    day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit'
  });
---

<BaseLayout
  title={`${noticia.data.title} - NotíciasJá`}
  description={noticia.data.description}
  image={noticia.data.image}
>
  <article class="article">
    <div class="container article-container">
      <nav class="breadcrumb">
        <a href="/">Início</a>
        <span>/</span>
        <a href={`/categoria/${noticia.data.category.toLowerCase()}`}>{noticia.data.category}</a>
      </nav>

      <header class="article-header">
        <span class="category-tag">{noticia.data.category}</span>
        <h1>{noticia.data.title}</h1>
        <p class="lead">{noticia.data.description}</p>
        <div class="meta">
          <span class="author">Por {noticia.data.author}</span>
          <span class="dot">•</span>
          <time datetime={noticia.data.pubDate.toISOString()}>
            {formatDate(noticia.data.pubDate)}
          </time>
        </div>
      </header>
    </div>

    {noticia.data.image && (
      <div class="container">
        <figure class="article-image">
          <img src={noticia.data.image} alt={noticia.data.title} />
        </figure>
      </div>
    )}

    <div class="container article-container">
      <div class="article-body">
        <Content />
      </div>

      <footer class="article-footer">
        <a href="/" class="back-link">← Voltar para a home</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .article { padding: 40px 0 80px; }
  .article-container { max-width: 760px; }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 24px;
    display: flex;
    gap: 8px;
  }
  .breadcrumb a { transition: color 0.2s; }
  .breadcrumb a:hover { color: var(--color-accent); }

  .article-header { margin-bottom: 32px; }
  .category-tag {
    display: inline-block;
    color: var(--color-accent);
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 16px;
  }
  .article-header h1 {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }
  .lead {
    font-size: 1.2rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 24px;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 0.9rem;
    color: var(--color-muted);
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    flex-wrap: wrap;
  }
  .author { font-weight: 600; color: var(--color-text); }

  .article-image {
    margin: 32px 0;
    border-radius: 12px;
    overflow: hidden;
  }
  .article-image img { width: 100%; }

  .article-body {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #1f2937;
  }
  .article-body :global(p) { margin-bottom: 24px; }
  .article-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    margin: 40px 0 16px;
    letter-spacing: -0.01em;
    color: #0f0f0f;
  }
  .article-body :global(h3) {
    font-size: 1.35rem;
    margin: 32px 0 12px;
    font-weight: 700;
    color: #0f0f0f;
  }
  .article-body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 24px 24px;
  }
  .article-body :global(li) { margin-bottom: 8px; }
  .article-body :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding: 8px 24px;
    margin: 24px 0;
    font-style: italic;
    color: var(--color-muted);
    background: var(--color-surface);
    border-radius: 0 8px 8px 0;
  }
  .article-body :global(img) {
    border-radius: 10px;
    margin: 24px 0;
  }
  .article-body :global(code) {
    background: var(--color-surface);
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.9em;
    font-family: 'SF Mono', Monaco, monospace;
  }
  .article-body :global(pre) {
    background: #0f0f0f;
    color: #e5e7eb;
    padding: 20px;
    border-radius: 10px;
    overflow-x: auto;
    margin: 24px 0;
  }
  .article-body :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }
  .article-body :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 40px 0;
  }

  .article-footer {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-border);
  }
  .back-link {
    color: var(--color-accent);
    font-weight: 600;
    transition: transform 0.2s;
    display: inline-block;
  }
  .back-link:hover { transform: translateX(-4px); }

  @media (max-width: 700px) {
    .article-header h1 { font-size: 1.85rem; }
    .lead { font-size: 1.05rem; }
    .article-body { font-size: 1.05rem; }
  }
</style>
